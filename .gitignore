# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
.pnp
.pnp.js

# frontend (Next.js) build output
frontend/.next/
frontend/out/
frontend/next-env.d.ts
frontend/*.tsbuildinfo

# backend (Python/FastAPI, added in Phase 3)
backend/__pycache__/
backend/**/__pycache__/
backend/.venv/
backend/*.egg-info/

# testing
coverage/

# provisioning state (resource ids from infra/aws scripts)
infra/aws/.provision-state

# secrets — never commit real values, see .env.example
.env
.env.local
.env.*.local

# misc
.DS_Store
Thumbs.db
npm-debug.log*
yarn-debug.log*
yarn-error.log*
build.zip
